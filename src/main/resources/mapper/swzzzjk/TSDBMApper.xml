<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="api.data.swzzzjk.TSDBData">
    <select id="selectList" resultType="api.pojo.swzzzjk.TSDBPojo">
        select  *  from  TSDB
        <where>
            <if test="stime != null and stime != ''">
                <![CDATA[ and time >=to_date('${stime}','YYYY-MM-DD HH24:MI:SS') ]]>
            </if>
            <if test="etime != null and etime != ''">
                <![CDATA[ and time <=to_date('${etime}','YYYY-MM-DD HH24:MI:SS')]]>
            </if>
            <if test="stcdList != null and stcdList.size() > 0">
                and  senid  in
                <foreach collection="stcdList" open="(" close=")" item="stcd" separator=",">
                    #{stcd}
                </foreach>
            </if>
        </where>
        order by time asc
    </select>
</mapper>