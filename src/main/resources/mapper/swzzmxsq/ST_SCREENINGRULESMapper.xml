    <select id="selectList" resultType="api.pojo.swzzmxsq.ST_SCREENINGRULESPojo">
        select * from ST_SCREENINGRULES
        <where>
            <if test="STCDList != null and STCDList.size() > 0">
                and id in
                <foreach collection="STCDList" open="(" close=")" item="STCD" separator=",">
                    #{STCD}
                </foreach>
            </if>
            <if test="pathname != null and pathname != ''">
                and type = #{pathname}
            </if>
            <if test="key != null and key != ''">
                and (name like'%'+#{key}+'%' or note like'%'+#{key}+'%')
            </if>
        </where>
        order by ordernum asc
    </select>
