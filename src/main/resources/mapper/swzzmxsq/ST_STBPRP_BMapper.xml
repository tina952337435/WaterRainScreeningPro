        <where>
            <if test="STCDList != null and STCDList.size() > 0">
                and  ST_STBPRP_B_DISTANCE.STCD in
                <foreach collection="STCDList" open="(" close=")" item="STCD" separator=",">
                    #{STCD}
                </foreach>
            </if>
            <if test="STNM != null and STNM != ''">
                and STNM = #{STNM}
            </if>
            <if test="key != null and key != ''">
                and (stnm like'%'+#{key}+'%' or stlc like'%'+#{key}+'%')
            </if>
        </where>
        order by ST_STBPRP_B_DISTANCE.DISTANCE asc
    </select>
