<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="api.data.swzzmxsq.ST_STBPRP_B_STCDData">
    <select id="selectList" resultType="api.pojo.swzzmxsq.ST_STBPRP_B_STCDPojo">
        select * from ST_STBPRP_B_STCD
        <where>
            <if test="stcdList != null and stcdList.size() > 0">
                and STCD in
                <foreach collection="stcdList" open="(" close=")" item="stcd" separator=",">
                    #{stcd}
                </foreach>
            </if>
            <if test="typeList != null and typeList.size() > 0">
                and TYPE in
                <foreach collection="typeList" open="(" close=")" item="type" separator=",">
                    #{type}
                </foreach>
            </if>
            <if test="sourceList != null and sourceList.size() > 0">
                and SOURCE in
                <foreach collection="sourceList" open="(" close=")" item="source" separator=",">
                    #{source}
                </foreach>
            </if>
        </where>
    </select>
    <delete id="deleteOne">
        delete from ST_STBPRP_B_STCD where STCD = #{STCD} AND TYPE = #{TYPE}
    </delete>


    <update id="upDateOne" parameterType="api.pojo.swzzmxsq.ST_STBPRP_B_STCDPojo">
        update ST_STBPRP_B_STCD
        <set>
            <if test="LASTTM != null and LASTTM != ''">
                LASTTM=#{LASTTM},
            </if>
            <if test="ZTM != null and ZTM != ''">
                ZTM=#{ZTM},
            </if>
            <if test="DAYLASTTM != null and DAYLASTTM != ''">
                DAYLASTTM=#{DAYLASTTM},
            </if>
            <if test="MONTHLASTTM != null and MONTHLASTTM != ''">
                MONTHLASTTM=#{MONTHLASTTM},
            </if>
            <if test="XUNLASTTM != null and XUNLASTTM != ''">
                XUNLASTTM=#{XUNLASTTM},
            </if>
            <if test="YEARLASTTM != null and YEARLASTTM != ''">
                YEARLASTTM=#{YEARLASTTM},
            </if>
        </set>
        where STCD = #{STCD} and TYPE=#{TYPE}
    </update>
</mapper>